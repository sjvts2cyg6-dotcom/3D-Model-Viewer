{
  "name": "webgpu-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Minimal, dependency-light WebGPU rendering engine skeleton (browser target).",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/bake && tsc --noEmit -p tools/local",
    "screenshot": "node scripts/screenshot.mjs",
    "check:shaders": "node scripts/check-shader-variants.mjs",
    "bake": "tsx tools/bake/cli.ts",
    "test": "tsx --test tools/bake/test/*.test.ts tools/local/test/*.test.ts",
    "local": "tsx tools/local/cli.ts"
  },
  "dependencies": {
    "wgpu-matrix": "^3.4.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@webgpu/types": "^0.1.74",
    "astc-encoder.js": "1.0.0",
    "jpeg-js": "^0.4.4",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "mikktspace": "^1.1.1",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "license": "MIT"
}
